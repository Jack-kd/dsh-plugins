{
  "name": "@local/rea-tools",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "REA 逆向工具链（REA + Ghidra + JADX）一键安装 + 原生二进制 / APK 逆向工具；v0.2.7 新增「逆向分析优选规则」系统提示，AI 遇 APK/二进制自动确定调用 rea 工具",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "install-manager.js",
    "cordis.patch.yml",
    "install-rea-ghidra.sh",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "rea",
    "ghidra",
    "reverse-engineering"
  ],
  "license": "MIT"
}