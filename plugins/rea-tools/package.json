{
  "name": "@local/rea-tools",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "REA 逆向工具链（REA + Ghidra + JADX）一键安装 + 原生二进制 / APK 逆向工具；v0.2.6 深度审查修复：UI 复选框中间态禁用、设置页查看进度生效、ghidra-only 进度与阶段、记住选择生效、完成提示、取消确认框关闭、版本/体积常量集中",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "install-manager.js",
    "cordis.patch.yml",
    "install-rea-ghidra.sh",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "rea",
    "ghidra",
    "reverse-engineering"
  ],
  "license": "MIT"
}