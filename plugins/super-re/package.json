{
  "name": "@local/super-re",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "超级逆向：REA 逆向环境（JADX + Ghidra + apktool）一键安装 + Craft Anything（321 工具）可选勾选安装，统一环境配置弹窗",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "install-manager.js",
    "install-rea-ghidra.sh",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "rea",
    "craft-anything",
    "ghidra",
    "jadx",
    "reverse-engineering"
  ],
  "license": "MIT"
}
