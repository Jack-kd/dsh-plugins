{
  "name": "dsh-jack-market",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "description": "Jack-kd 的 DSH 插件市场：直接从 GitHub 仓库浏览并一键安装插件；v0.7.3 下载提速约 16 倍（并行竞速替代串行重试）+ sha256 校验防镜像污染",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
