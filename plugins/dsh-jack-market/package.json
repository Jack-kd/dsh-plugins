{
  "name": "dsh-jack-market",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "description": "Jack-kd 的 DSH 插件市场：直接从 GitHub 仓库浏览并一键安装插件；v0.7.4 插件列表加载提速（缓存 15 分钟+后台刷新+启动预热，避免每次等 10 秒）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
