{
  "name": "dsh-jack-market",
  "version": "0.7.5",
  "private": true,
  "type": "module",
  "description": "Jack-kd 的 DSH 插件市场：直接从 GitHub 仓库浏览并一键安装插件；v0.7.5 修复列表加载失败/HTTP 502（undici fetch 在弱网下拉大 JSON 失败，改用原生 https + connection:close）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
