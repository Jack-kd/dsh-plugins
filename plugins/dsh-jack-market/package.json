{
  "name": "dsh-jack-market",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "description": "Jack-kd 的 DSH 插件市场：直接从 GitHub 仓库浏览并一键安装插件；v0.7.2 修复「装 A 插件却报 B 包缺 integrity 而失败」（自动把 URL 依赖改写成本地 file:）+ 装完自动启用 + 深色按钮可读",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
