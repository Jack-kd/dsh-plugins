{
  "name": "@local/gh-accel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub 下载/上传加速插件：自动测速选最快镜像 + 多线程分段下载 + git/pip 全局配置",
  "exports": {
    ".": "./index.js",
    "./lib.js": "./lib.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}